{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true
  },
  "include": [
    "tests/**/*", "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "online",
    "dist",
    "lib.cjs",
    "lib.esm"
  ]
}
